{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HANDOFF Document Schema",
  "description": "Schema for validating HANDOFF.md structure",
  "type": "object",
  "required": ["currentState", "nextSteps", "blockers", "lastUpdated"],
  "properties": {
    "currentState": {
      "type": "string",
      "minLength": 50,
      "description": "Current state of the project"
    },
    "nextSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "List of next steps to be taken"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Current blockers or issues"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "freshnessThreshold": {
      "type": "number",
      "default": 7,
      "description": "Maximum days since last update before considered stale"
    }
  }
}
